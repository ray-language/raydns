//! The DNS wire format as a server needs it (RFC 1035, EDNS0 from RFC 6891): read a query,
//! write a response with name compression, truncate it for UDP. `net/dns` only builds queries
//! and reads answers.

pub const A: int = 1;

pub const NS: int = 2;

pub const CNAME: int = 5;

pub const SOA: int = 6;

pub const MX: int = 15;

pub const TXT: int = 16;

pub const AAAA: int = 28;

pub const SRV: int = 33;

pub const OPT: int = 41;

pub const ANY: int = 255;

pub const IN: int = 1;

pub const NOERROR: int = 0;

pub const FORMERR: int = 1;

pub const SERVFAIL: int = 2;

pub const NXDOMAIN: int = 3;

pub const NOTIMP: int = 4;

pub const REFUSED: int = 5;

/// The smallest UDP payload every resolver takes, and the one we offer with EDNS (the DNS
/// flag day 2020 value: no IP fragmentation).
pub const CLASSIC_UDP: int = 512;

pub const EDNS_UDP: int = 1232;

pub struct Question {
    /// As the client wrote it (case kept for the echo), without the final dot.
    name: string,
    qtype: int,
    qclass: int,
}

pub struct Query {
    id: int,
    opcode: int,
    rd: bool,
    question: Question,
    /// The client's EDNS UDP size, or 0 if it sent no OPT record.
    edns: int,
}

pub enum Data {
    Addr4([int]),
    Addr6([int]),
    Name(string),
    Mx(int, string),
    Txt([string]),
    Srv(int, int, int, string),
    Soa(string, string, int, int, int, int, int),
}

pub struct Rr {
    name: string,
    rtype: int,
    ttl: int,
    data: Data,
}

pub struct Answer {
    rcode: int,
    authoritative: bool,
    answers: [Rr],
    authority: [Rr],
    additional: [Rr],
}

pub fn empty(rcode: int) -> Answer {
    Answer { rcode: rcode, authoritative: false, answers: [], authority: [], additional: [] }
}

/// Why a datagram is not a query we can answer, and with what (`id` is 0 when even the
/// header was unreadable: such a datagram is dropped).
pub struct Bad {
    id: int,
    rcode: int,
    reason: string,
}

fn u16(b: bytes, i: int) -> int {
    (b[i] << 8) | b[i + 1]
}

/// Reads a name at `pos`, following compression pointers (never more than the message
/// length, so a loop of pointers cannot spin). Returns the name and where the field ends.
pub fn read_name(b: bytes, pos: int) -> Result<(string, int), string> {
    var labels: [string] = [];
    var p = pos;
    var end = -1;
    var jumps = 0;
    var total = 0;
    while (true) {
        if (p >= b.len()) {
            return Result.Err("name runs past the message");
        }
        let len = b[p];
        if ((len & 0xC0) == 0xC0) {
            if (p + 1 >= b.len()) {
                return Result.Err("truncated pointer");
            }
            if (end < 0) {
                end = p + 2;
            }
            jumps = jumps + 1;
            if (jumps > b.len()) {
                return Result.Err("pointer loop");
            }
            p = ((len & 0x3F) << 8) | b[p + 1];
            continue;
        }
        if ((len & 0xC0) != 0) {
            return Result.Err("unknown label type");
        }
        if (len == 0) {
            if (end < 0) {
                end = p + 1;
            }
            break;
        }
        if (p + 1 + len > b.len()) {
            return Result.Err("label runs past the message");
        }
        total = total + len + 1;
        if (total > 255) {
            return Result.Err("name longer than 255 octets");
        }
        labels.push(from_utf8(b.sub_bytes(p + 1, p + 1 + len)).unwrap_or("?"));
        p = p + 1 + len;
    }
    Result.Ok((join(labels, "."), end))
}

/// Parses a query. Anything but a standard query with one question gets the rcode to send.
pub fn parse_query(b: bytes) -> Result<Query, Bad> {
    if (b.len() < 12) {
        return Result.Err(Bad { id: 0, rcode: FORMERR, reason: "shorter than a header" });
    }
    let id = u16(b, 0);
    let flags = u16(b, 2);
    if ((flags & 0x8000) != 0) {
        return Result.Err(Bad { id: 0, rcode: FORMERR, reason: "a response, not a query" });
    }
    let opcode = (flags >> 11) & 0xF;
    if (opcode != 0) {
        return Result.Err(Bad { id: id, rcode: NOTIMP, reason: "opcode ${opcode}" });
    }
    if (u16(b, 4) != 1) {
        return Result.Err(Bad { id: id, rcode: FORMERR, reason: "not exactly one question" });
    }
    let (name, at) = match (read_name(b, 12)) {
        Result.Ok(v) => v,
        Result.Err(e) => return Result.Err(Bad { id: id, rcode: FORMERR, reason: e }),
    };
    if (at + 4 > b.len()) {
        return Result.Err(Bad { id: id, rcode: FORMERR, reason: "truncated question" });
    }
    let q = Question { name: name, qtype: u16(b, at), qclass: u16(b, at + 2) };
    // EDNS: an OPT record among the additional ones (after any answer/authority records,
    // which a query does not carry).
    var edns = 0;
    let arcount = u16(b, 10);
    var p = at + 4;
    var i = 0;
    while (i < arcount && p < b.len()) {
        let (_, after) = match (read_name(b, p)) {
            Result.Ok(v) => v,
            Result.Err(_) => break,
        };
        if (after + 10 > b.len()) {
            break;
        }
        let rtype = u16(b, after);
        if (rtype == OPT) {
            edns = u16(b, after + 2);
            if (edns < CLASSIC_UDP) {
                edns = CLASSIC_UDP;
            }
        }
        p = after + 10 + u16(b, after + 8);
        i = i + 1;
    }
    Result.Ok(Query { id: id, opcode: opcode, rd: (flags & 0x0100) != 0, question: q, edns: edns })
}

// --- Writing ---

struct Out {
    buf: [int],
    /// Lowercased suffix → offset, for compression.
    seen: Map<string, int>,
}

fn put16(o: Out, n: int) {
    o.buf.push((n >> 8) & 0xFF);
    o.buf.push(n & 0xFF);
}

fn put32(o: Out, n: int) {
    put16(o, (n >> 16) & 0xFFFF);
    put16(o, n & 0xFFFF);
}

fn put_name(o: Out, name: string) {
    let labels = if (name == "") { [] } else { name.split(".") };
    for i in 0..labels.len() {
        let suffix = join(labels.slice(i, labels.len()), ".").to_lower();
        match (o.seen.get(suffix)) {
            Option.Some(off) => {
                put16(o, 0xC000 | off);
                return;
            },
            Option.None => { },
        }
        if (o.buf.len() < 0x3FFF) {
            o.seen.insert(suffix, o.buf.len());
        }
        let raw = labels[i].to_bytes();
        o.buf.push(raw.len());
        for x in raw {
            o.buf.push(x);
        }
    }
    o.buf.push(0);
}

// The RDATA of a record, with its length in front. Names inside NS/CNAME/MX/SOA may be
// compressed (RFC 3597 §4); SRV targets must not be (RFC 2782).
fn put_data(o: Out, d: Data) {
    let at = o.buf.len();
    put16(o, 0);
    match (d) {
        Data.Addr4(xs) => {
            for x in xs {
                o.buf.push(x);
            }
        },
        Data.Addr6(xs) => {
            for x in xs {
                o.buf.push(x);
            }
        },
        Data.Name(n) => put_name(o, n),
        Data.Mx(pref, n) => {
            put16(o, pref);
            put_name(o, n);
        },
        Data.Txt(parts) => {
            for t in parts {
                let raw = t.to_bytes();
                let n = if (raw.len() > 255) { 255 } else { raw.len() };
                o.buf.push(n);
                for j in 0..n {
                    o.buf.push(raw[j]);
                }
            }
        },
        Data.Srv(prio, weight, port, target) => {
            put16(o, prio);
            put16(o, weight);
            put16(o, port);
            let saved = o.seen;
            o.seen = Map.new();
            put_name(o, target);
            o.seen = saved;
        },
        Data.Soa(mname, rname, serial, refresh, retry, expire, minimum) => {
            put_name(o, mname);
            put_name(o, rname);
            put32(o, serial);
            put32(o, refresh);
            put32(o, retry);
            put32(o, expire);
            put32(o, minimum);
        },
    }
    let len = o.buf.len() - at - 2;
    o.buf[at] = (len >> 8) & 0xFF;
    o.buf[at + 1] = len & 0xFF;
}

fn put_rr(o: Out, r: Rr) {
    put_name(o, r.name);
    put16(o, r.rtype);
    put16(o, IN);
    put32(o, r.ttl);
    put_data(o, r.data);
}

/// Writes the response to `q`. `limit` is the most a UDP reply may carry (0 = no limit, for
/// TCP); a longer one is cut to the header, question and OPT, with TC set, so the client
/// asks again over TCP.
pub fn write_response(q: Query, a: Answer, limit: int) -> bytes {
    let full = render(q, a, false);
    if (limit == 0 || full.len() <= limit) {
        return full;
    }
    render(
        q,
        Answer {
            rcode: a.rcode,
            authoritative: a.authoritative,
            answers: [],
            authority: [],
            additional: []
        },
        true
    )
}

fn render(q: Query, a: Answer, truncated: bool) -> bytes {
    let o = Out { buf: [], seen: Map.new() };
    put16(o, q.id);
    var flags = 0x8000 | (q.opcode << 11) | (a.rcode & 0xF);
    if (a.authoritative) {
        flags = flags | 0x0400;
    }
    if (truncated) {
        flags = flags | 0x0200;
    }
    if (q.rd) {
        flags = flags | 0x0100;
    }
    put16(o, flags);
    put16(o, 1);
    put16(o, a.answers.len());
    put16(o, a.authority.len());
    put16(o, a.additional.len() + if (q.edns > 0) { 1 } else { 0 });
    put_name(o, q.question.name);
    put16(o, q.question.qtype);
    put16(o, q.question.qclass);
    for r in a.answers {
        put_rr(o, r);
    }
    for r in a.authority {
        put_rr(o, r);
    }
    for r in a.additional {
        put_rr(o, r);
    }
    if (q.edns > 0) {
        o.buf.push(0);
        put16(o, OPT);
        put16(o, EDNS_UDP);
        put32(o, 0);
        put16(o, 0);
    }
    bytes_of(o.buf)
}

/// A bare error reply for a datagram that did not parse as a query we answer.
pub fn write_error(b: Bad, request: bytes) -> bytes {
    var out: [int] = [(b.id >> 8) & 0xFF, b.id & 0xFF];
    // QR, the request's opcode and RD, and the rcode; no sections.
    let flags = if (request.len() >= 4) { u16(request, 2) } else { 0 };
    let f = 0x8000 | (flags & 0x7900) | b.rcode;
    out = out + [(f >> 8) & 0xFF, f & 0xFF, 0, 0, 0, 0, 0, 0, 0, 0];
    bytes_of(out)
}

/// The UDP size a reply to `q` may use.
pub fn udp_limit(q: Query) -> int {
    if (q.edns == 0) {
        CLASSIC_UDP
    } else if (q.edns > EDNS_UDP) {
        EDNS_UDP
    } else {
        q.edns
    }
}

// --- Addresses ---

/// `10.0.0.5` → its four octets.
pub fn parse_ipv4(s: string) -> Option<[int]> {
    let parts = s.split(".");
    if (parts.len() != 4) {
        return Option.None;
    }
    var out: [int] = [];
    for p in parts {
        if (p == "" || p.len() > 3) {
            return Option.None;
        }
        let n = parse_int(p)?;
        if (n < 0 || n > 255 || (p.len() > 1 && p[0] == '0')) {
            return Option.None;
        }
        out.push(n);
    }
    Option.Some(out)
}

fn hex_group(g: string) -> Option<int> {
    if (g == "" || g.len() > 4) {
        return Option.None;
    }
    var n = 0;
    for c in g.to_lower().chars() {
        n = n * 16 + "0123456789abcdef".index_of(to_string(c))?;
    }
    Option.Some(n)
}

/// `fd00::5` → its sixteen octets (`::` once at most; no embedded IPv4).
pub fn parse_ipv6(s: string) -> Option<[int]> {
    if (!s.contains(":")) {
        return Option.None;
    }
    let halves = s.split("::");
    if (halves.len() > 2) {
        return Option.None;
    }
    let groups = fn(part: string) -> Option<[int]> {
        if (part == "") {
            return Option.Some([]);
        }
        var out: [int] = [];
        for g in part.split(":") {
            out.push(hex_group(g)?);
        }
        Option.Some(out)
    };
    let head = groups(halves[0])?;
    let tail = if (halves.len() == 2) { groups(halves[1])? } else { [] };
    let missing = 8 - head.len() - tail.len();
    if ((halves.len() == 1 && missing != 0) || (halves.len() == 2 && missing < 1)) {
        return Option.None;
    }
    var all = head;
    for _ in 0..missing {
        all.push(0);
    }
    all = all + tail;
    var out: [int] = [];
    for g in all {
        out.push((g >> 8) & 0xFF);
        out.push(g & 0xFF);
    }
    Option.Some(out)
}

pub fn type_name(t: int) -> string {
    match (t) {
        1 => "A",
        2 => "NS",
        5 => "CNAME",
        6 => "SOA",
        15 => "MX",
        16 => "TXT",
        28 => "AAAA",
        33 => "SRV",
        255 => "ANY",
        _ => "TYPE${t}",
    }
}
